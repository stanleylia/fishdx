  "structural_finding": {
    "claim": "the evidence layer cannot change the retrieved disease identity",
    "reason": "the commitment rule is 'healthy if S_h > S_d else c1'; the disease label always comes from the Stage-2 retrieval candidate c1, so varying the document can only move a sample between c1 and Healthy, never between two diseases",
    "labels_ever_committed": [
      "aeromoniasis",
      "bacterial_gill",
      "bacterial_red",
      "fungal",
      "healthy",
      "parasitic",
      "viral_white_tail"
    ]
  }
